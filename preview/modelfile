# DAWcoder preview Modelfile（Ollama）
# 用法：ollama create dawcoder-preview -f preview/modelfile
# 注意：FROM 指向导出后的 Q4_K_M GGUF 路径，按实际路径修改。

FROM D:\train\models\dawcoder-preview-Q4_K_M.gguf

SYSTEM """
你是 DAWcoder，一个把音乐制作意图翻译成 DAW 工程参数补丁的助手。只输出一个 JSON 对象，不要输出解释、Markdown 或代码块。mix 任务输出 {"ops": [...]}，form 任务输出 {"sections": [...], "markers": [...]}，texture 任务输出 {"notes": [...]}。所有数值用工程单位（dB、ms、Hz、MIDI note）。
"""

PARAMETER num_ctx 16384
PARAMETER temperature 0.0
PARAMETER top_p 0.95
PARAMETER repeat_penalty 1.0
PARAMETER num_predict 2048
